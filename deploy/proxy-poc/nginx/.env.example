# NGINX Proxy POC Environment Variables

# Mattermost Configuration
MM_SITE_URL=http://localhost
MM_SQL_DRIVER=postgres
MM_SQL_USERNAME=mmuser
MM_SQL_PASSWORD=mm_password
MM_SQL_DB=mattermost
MM_ADMIN_EMAIL=admin@example.com
MM_ADMIN_USERNAME=mm-admin
MM_ADMIN_PASSWORD=Password123!

# Keycloak Configuration
KC_HTTP_PORT=8080
KC_HOSTNAME=keycloak.127.0.0.1.nip.io
KC_ADMIN_REALM=master
KC_ADMIN=admin
KC_ADMIN_PASSWORD=Keycloak123!
KC_ADMIN_EMAIL=admin@example.com
KC_DB_USER=keycloak
KC_DB_PASSWORD=kc_password
KC_DB_NAME=keycloak

# OIDC Configuration
OIDC_REALM=master
OIDC_CLIENT_ID=mm-oidc
OIDC_CLIENT_NAME="Mattermost OIDC Dev"
OIDC_ISSUER_URL=http://keycloak.127.0.0.1.nip.io:8080/realms/master
OIDC_SCOPES="openid profile email"
OIDC_ALLOW_INSECURE=true
OIDC_REDIRECT_PATH=/plugins/com.mm.oidc/callback

# Database Images
MM_PG_IMAGE=postgres:15-alpine
KC_PG_IMAGE=postgres:15-alpine

# Service Images
MATTERMOST_IMAGE=mattermost/mattermost-team-edition:latest
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:25.0
NGINX_IMAGE=nginx:1.25-alpine

# Proxy Port (exposed to host)
PROXY_PORT=80
